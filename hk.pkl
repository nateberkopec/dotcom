amends "package://github.com/jdx/hk/releases/download/v1.44.0/hk@1.44.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    steps {
      ["lint:ruby"] {
        check = "mise run lint:ruby"
      }
      ["lint:js"] {
        check = "mise run lint:js"
      }
      ["lint:site"] {
        check = "mise run lint:site"
      }
      ["test:ruby"] {
        check = "mise run test:ruby"
      }
      ["test:integration"] {
        check = "mise run test:integration"
      }
    }
  }
}
